# Copy to .env for local use. Never commit real secrets.
# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=analytics
POSTGRES_DSN=postgresql://user:pass@localhost:5432/analytics

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Ingestion
SOURCE_URL=sample.mp4
STREAM_ID=stream1
MAX_FPS=10
MAX_STREAM_LEN=1000
STALE_THRESHOLD_MS=300
RECONNECT_BASE_DELAY=1
RECONNECT_MAX_DELAY=30
# Force RTSP over TCP in OpenCV/FFmpeg to avoid UDP packet loss.
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp

# Worker
DETECTOR_BACKEND=onnx
MODEL_PATH=/models/yolov5n.onnx
MODEL_URL=https://github.com/ultralytics/yolov5/releases/download/v7.0/yolov5n.onnx
INPUT_SIZE=640
CONF_THRESHOLD=0.5
NMS_THRESHOLD=0.4
CONSUMER_GROUP=workers
CONSUMER_NAME=
MAX_DELIVERY_ATTEMPTS=3

# Event processor
BATCH_SIZE=10
FLUSH_INTERVAL=1.0
DB_BUFFER_MAX=2000
TRACK_IOU_THRESHOLD=0.3
TRACK_TTL_SECONDS=5

# Demo source
DEMO_STREAM_NAME=demo
DEMO_SOURCE_URL=rtsp://mediamtx:8554/demo
DEMO_TARGET_FPS=10
ALLOW_PRIVATE_HOSTS=mediamtx

# API
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=15
AUTH_ENABLED=1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin
RATE_LIMIT_PER_MINUTE=600
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Grafana
GRAFANA_PASSWORD=admin
