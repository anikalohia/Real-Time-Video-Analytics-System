# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# PostgreSQL
POSTGRES_DSN=postgresql://user:pass@localhost:5432/analytics

# Ingestion
SOURCE_URL=sample.mp4
STREAM_ID=stream1
MAX_FPS=10
MAX_STREAM_LEN=1000
STALE_THRESHOLD_MS=300

# Worker
DETECTOR_BACKEND=mock
MODEL_PATH=yolov5n.onnx
INPUT_SIZE=640
CONF_THRESHOLD=0.5
NMS_THRESHOLD=0.4
CONSUMER_GROUP=workers
CONSUMER_NAME=worker-1

# API
JWT_SECRET=change-me-in-production
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
